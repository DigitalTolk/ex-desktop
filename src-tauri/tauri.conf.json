{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ex",
  "version": "0.0.4",
  "identifier": "com.digitaltolk.ex",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm --prefix ../frontend run dev:tauri",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:* https: wss:; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:;"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ex"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEQTgyNUYwQjE0MzgxQzQKUldURWdVT3g4Q1dvSFV6RzFNcW9hem00Y0FBV2ZXczFOSmxZWVNYTWNFOStWbVYxa2JnblFwQWUK",
      "endpoints": [
        "https://github.com/DigitalTolk/ex-desktop/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/AppIcon.icon",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
