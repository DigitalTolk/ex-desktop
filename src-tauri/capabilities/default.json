{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the ex desktop app",
  "windows": ["main", "setup"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "store:allow-delete",
    "store:allow-clear",
    "store:allow-entries",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "updater:allow-download",
    "opener:default",
    "opener:allow-open-url",
    "notification:default",
    "deep-link:default",
    "global-shortcut:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
